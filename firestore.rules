rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function membersOf(pairingId) {
      return get(/databases/$(database)/documents/pairings/$(pairingId)).data.members;
    }

    function isMember(pairingId) {
      return signedIn() && uid() in membersOf(pairingId);
    }

    // A photo being handed back after delivery.
    //
    // The whole point of the transfer-only model: once both phones hold a
    // picture, the copy on the server is removed and nothing else about the
    // document may change with it. Locking the shape this tightly means the
    // permission to erase a photo can never become a permission to rewrite who
    // sent it or when.
    // Starring is a private opinion recorded on a shared document, so the
    // field is writable by either member. Nothing else may move with it - a
    // star must never become a way to edit what somebody said.
    function onlyChangesStars() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['starredBy']);
    }

    function onlyDropsImage() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['image'])
        && !('image' in request.resource.data);
    }

    match /users/{userId} {
      // Readable by any signed-in user so a partner can show your name and
      // avatar. Nothing sensitive lives on this document beyond the FCM token,
      // which is useless without the server credential needed to send to it.
      allow read: if signedIn();
      allow write: if signedIn() && uid() == userId;

      // The private reminder list.
      //
      // Subcollection rules do not inherit from the parent document, so the
      // permissive read above does not reach in here — this stays owner-only
      // even though the user document itself is readable by a partner.
      match /reminders/{reminderId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    match /pairings/{pairingId} {
      // Open to any signed-in user because joining works by querying for an
      // invite code, which has to happen before you are a member. A pairing
      // document holds only a member list and a code, so the exposure is
      // small — but moving codes into their own collection would remove it
      // entirely and is worth doing before this goes public.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.members == [uid()];

      // Two permitted updates, and nothing else.
      //
      // A second person joining: members can be added but never removed or
      // replaced, so nobody can evict a partner. Or a member repainting the
      // chat, which changes that one field and no other - in particular it can
      // never be a way to rewrite the member list.
      allow update: if signedIn() && (
        (
          resource.data.members.size() == 1
          && request.resource.data.members == resource.data.members.concat([uid()])
        ) || (
          isMember(pairingId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatTheme'])
        )
      );

      allow delete: if isMember(pairingId);

      match /messages/{messageId} {
        allow read: if isMember(pairingId);
        allow create: if isMember(pairingId)
          && request.resource.data.senderId == uid();
        // A message may lose its photo to the recipient's phone, or gain and
        // lose stars. Its words are still immutable — you can withdraw what
        // you said, but you cannot quietly rewrite it into something else.
        allow update: if isMember(pairingId)
          && (onlyDropsImage() || onlyChangesStars());

        // Only the person who sent it. Enforced here rather than only in the
        // app, because a rule is the one place a tampered client cannot argue
        // with.
        allow delete: if isMember(pairingId) && resource.data.senderId == uid();
      }

      // Options put up for the other person to judge.
      //
      // Either member may delete one — an option withdrawn or a decision made
      // should be clearable by whoever is looking at it. The verdict field is
      // not restricted to the non-author: enforcing that in rules would need a
      // read of the existing document on every vote, and voting on your own
      // option is a pointless act rather than a harmful one.
      match /choices/{choiceId} {
        allow read: if isMember(pairingId);
        allow create: if isMember(pairingId)
          && request.resource.data.addedBy == uid();
        allow update, delete: if isMember(pairingId);
      }

      // Delivery and read watermarks, one document per person.
      //
      // Writable only by whoever it belongs to, so nobody can mark their own
      // messages as read by the other person.
      match /receipts/{userId} {
        allow read: if isMember(pairingId);
        allow write: if isMember(pairingId) && uid() == userId;
      }

      // The shared reminder list. Either person may tick off, edit or remove
      // anything here — that mutual authority is the point of the list.
      match /reminders/{reminderId} {
        allow read: if isMember(pairingId);
        allow create: if isMember(pairingId)
          && request.resource.data.createdBy == uid();
        allow update, delete: if isMember(pairingId);
      }

      // Nudges are write-once. A Cloud Function watches for creations and
      // turns each one into a push on the other person's phone.
      match /nudges/{nudgeId} {
        allow read: if isMember(pairingId);
        allow create: if isMember(pairingId)
          && request.resource.data.fromUid == uid()
          && request.resource.data.toUid != uid();
        allow update, delete: if false;
      }

      // The call handshake. Both people read and write it freely: it is a
      // negotiation, and either side may be the one starting, answering or
      // hanging up. Nothing sensitive lives here - a session description is
      // useless to anyone who is not already a member of the pairing, and the
      // media itself never passes through Firestore at all.
      match /call/{document=**} {
        allow read, write: if isMember(pairingId);
      }

      // The shared player. Either member may control it - a jam where one of
      // you holds the remote is not a jam.
      match /jam/{document=**} {
        allow read, write: if isMember(pairingId);
      }

      // The jam chat, which either person may open, write in or delete. It is
      // meant to be thrown away, so deletion is not a privilege here.
      match /jamchat/{document=**} {
        allow read, write: if isMember(pairingId);
      }

      // A timetable each. Both people read both; only the owner writes their
      // own - seeing somebody's week and rewriting it are different things.
      match /timetables/{userId} {
        allow read: if isMember(pairingId);
        allow write: if isMember(pairingId) && uid() == userId;
      }

      match /strokes/{strokeId} {
        allow read: if isMember(pairingId);
        allow create: if isMember(pairingId)
          && request.resource.data.senderId == uid();
        allow update: if false;
        // Either person can clear the canvas.
        allow delete: if isMember(pairingId);
      }
    }

    match /moments/{momentId} {
      allow read: if isMember(resource.data.pairingId);
      allow create: if signedIn()
        && request.resource.data.senderId == uid()
        && isMember(request.resource.data.pairingId);
      allow update: if isMember(resource.data.pairingId) && onlyDropsImage();
      allow delete: if isMember(resource.data.pairingId);
    }
  }
}
