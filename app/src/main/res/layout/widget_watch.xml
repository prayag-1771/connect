<?xml version="1.0" encoding="utf-8"?>
<!--
  A plain RemoteViews layout rather than Glance.

  AnalogClock keeps its own time: once the launcher has inflated this, the
  hands move without the app being involved at all. Drawing a clock in Glance
  would mean redrawing the widget every minute from a background process,
  which is exactly the kind of work Android now goes out of its way to stop.

  AnalogClock is deprecated but remains on the RemoteViews whitelist, and
  nothing else in that whitelist can render moving hands.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/watch_root">

    <!--
      fitCenter, not centerCrop. The bitmap arrives already cut to a circle
      with transparent corners, so cropping it would slice the face.
    -->
    <ImageView
        android:id="@+id/watch_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@string/watch_widget_photo" />

    <!--
      Sits over the photo and fills the same square, so its dial ring lands on
      the edge of the circle rather than somewhere arbitrary.
    -->
    <AnalogClock
        android:id="@+id/watch_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:dial="@drawable/watch_dial"
        android:hand_hour="@drawable/watch_hand_hour"
        android:hand_minute="@drawable/watch_hand_minute" />

    <!--
      Tap target for the unread dot, which is painted into the photo bitmap and
      so cannot be clicked on its own. Top-left, matching where the renderer
      puts the dot. An ImageView because plain View is not on the RemoteViews
      whitelist.
    -->
    <ImageView
        android:id="@+id/watch_unread_touch"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:contentDescription="@string/watch_widget_unread"
        android:visibility="gone" />

    <!--
      The blue corner light: someone has drawn something. Both the indicator
      and its own tap target, which is why it is a real drawable rather than
      painted into the face bitmap like the green dot.
    -->
    <ImageView
        android:id="@+id/watch_drawing_glow"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:src="@drawable/drawing_glow"
        android:contentDescription="@string/watch_widget_drawing"
        android:visibility="gone" />

    <TextView
        android:id="@+id/watch_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:background="#99000000"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
</FrameLayout>
