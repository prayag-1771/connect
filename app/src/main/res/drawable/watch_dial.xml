<?xml version="1.0" encoding="utf-8"?>
<!--
  A white rim, and four marks at the quarters.

  The rim is what makes the photo read as a watch face rather than as a circular
  crop with hands over it - it gives the picture an edge to end at. Solid white
  because a faint one disappears against a bright photograph, which is most of
  them.

  The ring radius of 92 (of a 100 unit half-width) is duplicated as
  DIAL_RATIO in WatchFaceRenderer, which cuts the photo to end at exactly
  this line. Change one and the other must change with it, or the photo
  will sit inside or spill over the rim.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M100,100m-92,0a92,92 0,1 1,184 0a92,92 0,1 1,-184 0" />
    <path android:fillColor="#8CFFFFFF" android:pathData="M97,12h6v14h-6z" />
    <path android:fillColor="#8CFFFFFF" android:pathData="M97,174h6v14h-6z" />
    <path android:fillColor="#8CFFFFFF" android:pathData="M12,97h14v6h-14z" />
    <path android:fillColor="#8CFFFFFF" android:pathData="M174,97h14v6h-14z" />
</vector>
