<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Android 11 hides other apps from us unless we say what we are looking
      for. Without this, resolveActivity for the clock returns null even
      though a clock app is plainly installed, and the off-hours tap falls
      back to opening Connect — which is exactly what it must not do.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!--
          Named explicitly as a last resort. Several OEM clock apps ship no
          SHOW_ALARMS filter at all, so intent-based discovery finds nothing
          and only their launcher entry can be opened.
        -->
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.oneplus.deskclock" />
        <package android:name="com.oplus.alarmclock" />
        <package android:name="com.coloros.alarmclock" />
        <package android:name="com.sec.android.app.clockpackage" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Voice notes. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arms the sync schedule after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Lets the two-minute sync alarm fire on time rather than whenever the
      system feels like batching it. Revocable, and the alarm falls back to an
      inexact one if it is refused.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- The other person feels a reminder they are not meant to be woken by. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      A call needs the network state to pick a route, and screen capture needs
      a foreground service the system can see. The mediaProjection type is
      separately required from Android 10, and is what makes the persistent
      "sharing your screen" notification mandatory rather than optional.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Used only to compare against places saved on this phone. Coordinates are
      never written to Firestore and never sent to the other person.
      Background access is what lets the check run while the widget is the only
      thing on screen, which is the whole point of it.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The floating blue indicator. Granted by the user in Settings, not at runtime. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".ConnectApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Connect">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Connect"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".viewer.PhotoViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Connect" />

        <activity
            android:name=".editor.PhotoEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.Connect"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".archive.ArchiveActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Connect" />

        <activity
            android:name=".chat.QuickReplyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Connect.QuickReply"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <activity
            android:name=".draw.DrawingOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Connect.Overlay" />

        <receiver
            android:name=".widget.MomentWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/moment_widget_info" />
        </receiver>


        <service
            android:name=".messaging.ConnectMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.WatchWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watch_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ScheduleBoundaryReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.DailyResetReceiver"
            android:exported="false" />

        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:label="Call" />

        <service
            android:name=".jam.JamService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".call.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          Also the target of the Spotify login redirect. singleTask so coming
          back from the browser lands on the screen that started it rather than
          stacking a second copy.
        -->
        <activity
            android:name=".jam.SpotifySetupActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="Spotify">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="connect" android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <activity
            android:name=".jam.JamActivity"
            android:exported="false"
            android:label="Jam" />

        <activity
            android:name=".profile.SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <activity
            android:name=".starred.StarredActivity"
            android:exported="false"
            android:label="Starred" />

        <receiver
            android:name=".sync.FastSyncReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.ReminderAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".sync.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!--
          Hands the camera app a writable URI for one file in our cache. Not
          exported: the grant is passed per-intent and expires with it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          WorkManager's own initializer is removed so ConnectApplication can
          supply a Configuration carrying the Hilt worker factory. Leaving both
          in place means whichever runs first wins, which is not a coin flip
          worth taking.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
